# Pete's Vinyl settings. Copy this file to ".env" (the installer does it for you).
# Everything here can ALSO be filled in from the app's Settings screen (the ⚙️ button),
# which is easier. Values saved in the app win over values in this file.

# ---- About Pete (used in listings) ----
SELLER_NAME=Pete
SELLER_LOCATION=New Zealand
HOME_CURRENCY=NZD
SHIPPING_NOTE=Carefully packed in a proper record mailer. Happy to combine postage on multiple records.

# ---- AI helper: OpenRouter (reads photos + researches prices on the web) ----
# Create a key at https://openrouter.ai/keys and add credit at https://openrouter.ai/credits
OPENROUTER_API_KEY=
# Any OpenRouter model that accepts images. Cheap + good: google/gemini-2.5-flash
OPENROUTER_MODEL=google/gemini-2.5-flash
AI_WEB_SEARCH=true

# ---- Discogs (free, instant): https://www.discogs.com/settings/developers -> "Generate new token" ----
DISCOGS_API_TOKEN=
# New Discogs listings are created as Draft (safe) or For Sale (live immediately)
DISCOGS_LISTING_STATUS=Draft

# ---- TradeMe API (optional; needs an approved app: https://developer.trademe.co.nz) ----
TRADEME_CONSUMER_KEY=
TRADEME_CONSUMER_SECRET=
TRADEME_OAUTH_TOKEN=
TRADEME_OAUTH_TOKEN_SECRET=
TRADEME_SANDBOX=true
# Category number for vinyl records (look it up via https://api.trademe.co.nz/v1/Categories.json)
TRADEME_CATEGORY=
TRADEME_DURATION_DAYS=7

# ---- eBay Inventory API (optional; https://developer.ebay.com) ----
EBAY_OAUTH_TOKEN=
EBAY_SANDBOX=true
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_CURRENCY=USD
EBAY_CATEGORY_ID=176985
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
EBAY_LOCATION_KEY=

# ---- Which selling sites to show (trademe, discogs, ebay, facebook, gumtree) ----
ENABLED_PLATFORMS=trademe,discogs,ebay,facebook,gumtree

# ---- Backup (leave empty to auto-find Google Drive for Desktop, e.g. G:\My Drive\PetesVinyl Backup) ----
BACKUP_FOLDER=
BACKUP_EVERY_HOURS=6
